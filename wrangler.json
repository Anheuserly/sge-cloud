{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sge-cloud",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "keep_vars": false,
  "routes": [
    {
      "pattern": "cloud.sge.amcmep.in",
      "zone_name": "amcmep.in",
      "custom_domain": true
    },
    {
      "pattern": "www.cloud.sge.amcmep.in",
      "zone_name": "amcmep.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
